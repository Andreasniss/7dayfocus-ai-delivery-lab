{
  "name": "7dayfocus-ai-delivery-lab",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first weekly planner used as an inspectable AI-assisted delivery reference project.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andreasniss/7dayfocus-ai-delivery-lab.git"
  },
  "bugs": {
    "url": "https://github.com/Andreasniss/7dayfocus-ai-delivery-lab/issues"
  },
  "homepage": "https://github.com/Andreasniss/7dayfocus-ai-delivery-lab#readme",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "serve": "node server/index.mjs",
    "start": "npm run build && npm run serve",
    "build": "tsc -b && vite build",
    "lint": "oxlint src server scripts vite.config.ts --deny-warnings",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/utilities": "3.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.7.0",
    "happy-dom": "20.12.0",
    "oxlint": "1.80.0",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
